# Homelab MCP Server — example environment file
# -----------------------------------------------------------------------------
# Copy this to a real env file and fill in your secrets:
#     cp .env.example .env
# Then point compose.yml's `env_file:` at it (the shipped compose reads from
# /etc/homelab/homelab-mcp.env — adjust to taste).
#
# THIS is where every secret lives. config.yaml holds only non-secret routing
# info (hostnames, URLs, key paths); the actual keys/tokens go here so they
# never enter the model's context. See docs/security.md.
#
# Real env files are gitignored. Only THIS .example is committed.
# Every variable below is OPTIONAL — set only the ones whose tools you use.
# A missing variable just makes its tool return a clear error when called.
# =============================================================================

# --- Server controls -------------------------------------------------------
# Path to config.yaml inside the container (already set in compose/Dockerfile).
# CONFIG_PATH=/app/config.yaml

# If set, every request must send `Authorization: Bearer <this value>`.
# Leave UNSET for LAN-trust instances (no auth). Set it for any instance you
# expose publicly. See docs/security.md.
# MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Comma-separated allowlist. If set, ONLY these tools are registered; all
# others become invisible to clients. Leave unset to expose every tool.
# Used by the read-only deployment profiles — see docs/configuration.md.
# MCP_ENABLED_TOOLS=list_hosts,docker_ps,docker_logs,read_file,loki_query

# --- Home Assistant (ha_* tools) -------------------------------------------
# Long-lived access token: HA profile -> Security -> Long-lived access tokens.
# Base URL goes in config.yaml under api_services.homeassistant.base_url.
# HA_TOKEN=

# --- OPNsense (caddy_* / opnsense_* tools) ---------------------------------
# System -> Access -> Users -> your user -> API keys. URL goes in config.yaml.
# OPNSENSE_API_KEY=
# OPNSENSE_API_SECRET=

# --- Cloudflare (cloudflare_* tools) ---------------------------------------
# Two scoped tokens from dash.cloudflare.com -> My Profile -> API Tokens.
# account_id / tunnel_id go in config.yaml under the `cloudflare` block.
# CLOUDFLARE_TUNNEL_API_TOKEN=   # permission: Cloudflare Tunnel: Edit
# CLOUDFLARE_ACCESS_API_TOKEN=   # permission: Access: Apps and Policies: Edit

# --- Proxmox (proxmox_* tools) ---------------------------------------------
# One token PER node. The variable name is the node's `name` from config.yaml,
# UPPER-CASED, plus _API_TOKEN. So `name: pve1` -> PVE1_API_TOKEN.
# Avoid hyphens/dots in the node name — they make an invalid env var name.
# Token format: user@realm!tokenid=uuid-secret
# PVE1_API_TOKEN=root@pam!mcp=00000000-0000-0000-0000-000000000000
# PVE2_API_TOKEN=
# ...one per node through PVE6_API_TOKEN

# --- Homelab API proxy services (homelab_api_* tools) ----------------------
# One variable per service, whose NAME is the `auth_env` you set in that
# service's config.yaml block. Examples matching config.example.yaml:
# RADARR_API_KEY=
# SABNZBD_API_KEY=
# GRAFANA_API_TOKEN=
#
# For services that use username/password auth (auth_env_user / auth_env_pass
# in config.yaml), set both halves, e.g.:
# MYSERVICE_USER=
# MYSERVICE_PASS=
